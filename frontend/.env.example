# Google AI Studio key. Server-side only — never exposed to the browser.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemma 4 on the Gemini API. `gemma-4-31b-it` is the larger, more capable
# multimodal variant; `gemma-4-26b-a4b-it` is the faster mixture-of-experts one.
GEMMA_MODEL=gemma-4-31b-it
